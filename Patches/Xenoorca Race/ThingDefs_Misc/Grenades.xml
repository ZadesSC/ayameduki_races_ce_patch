<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>[Aya]Xenoorca Race</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="Proj_GrenadeFrag_XO"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>
              <ThingDef ParentName="BaseFragGrenadeProjectile_XO">
                <defName>Proj_GrenadeFrag_XO</defName>
                <label>Orca custom frag grenade</label>
              </ThingDef>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="Weapon_GrenadeFrag_XO"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>
              <ThingDef ParentName="HAR_XO_BaseWeaponNeolithic">
                <defName>Weapon_GrenadeFrag_XO</defName>
                <label>Orca custom frag grenade</label>
                <description>A compact Xenoorca grenade modified for longer throws and a narrow blast.</description>
                <tickerType>Normal</tickerType>
                <techLevel>Industrial</techLevel>
                <graphicData>
                  <texPath>HAR_XO/Weapons/XO_W_Gr</texPath>
                  <graphicClass>Graphic_Single</graphicClass>
                </graphicData>
                <statBases>
                  <Mass>1</Mass>
                  <RangedWeapon_Cooldown>1.3</RangedWeapon_Cooldown>
                  <WorkToMake>12000</WorkToMake>
                </statBases>
                <costList>
                  <Steel>80</Steel>
                  <Chemfuel>150</Chemfuel>
                </costList>
                <weaponTags>
                  <li>HAR_XO_weapon</li>
                </weaponTags>
                <verbs>
                  <li>
                    <verbClass>Verb_LaunchProjectile</verbClass>
                    <range>23</range>
                    <defaultProjectile>Proj_GrenadeFrag_XO</defaultProjectile>
                  </li>
                </verbs>
                <comps>
                  <li Class="CompProperties_Explosive">
                    <explosiveRadius>2.66</explosiveRadius>
                    <explosiveDamageType>Bomb</explosiveDamageType>
                    <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
                  </li>
                </comps>
              </ThingDef>
            </value>
          </nomatch>
        </li>
        <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
          <defName>Weapon_GrenadeFrag_XO</defName>
          <statBases>
            <Mass>1</Mass>
            <Bulk>1.05</Bulk>
            <RangedWeapon_Cooldown>1.3</RangedWeapon_Cooldown>
            <SightsEfficiency>1</SightsEfficiency>
          </statBases>
          <Properties>
            <verbClass>CombatExtended.Verb_ShootCEOneUse</verbClass>
            <hasStandardCommand>true</hasStandardCommand>
            <range>23</range>
            <warmupTime>0.75</warmupTime>
            <noiseRadius>4</noiseRadius>
            <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
            <soundCast>ThrowGrenade</soundCast>
            <targetParams>
              <canTargetLocations>true</canTargetLocations>
            </targetParams>
            <defaultProjectile>Proj_GrenadeFrag_XO</defaultProjectile>
            <onlyManualCast>true</onlyManualCast>
            <ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
            <ai_AvoidFriendlyFireRadius>5</ai_AvoidFriendlyFireRadius>
          </Properties>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[@Name="BaseFragGrenadeProjectile_XO"]/thingClass</xpath>
          <value>
            <thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
          </value>
        </li>
        <li Class="PatchOperationAttributeSet">
          <xpath>Defs/ThingDef[@Name="BaseFragGrenadeProjectile_XO"]/projectile</xpath>
          <attribute>Class</attribute>
          <value>CombatExtended.ProjectilePropertiesCE</value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[@Name="BaseFragGrenadeProjectile_XO"]/projectile</xpath>
          <value>
            <damageAmountBase>56</damageAmountBase>
            <suppressionFactor>3</suppressionFactor>
            <dangerFactor>2</dangerFactor>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="Weapon_GrenadeFrag_XO"]</xpath>
          <value>
            <li Class="zades.ayamedukiracece.AbilityExplosionExtension"/>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
