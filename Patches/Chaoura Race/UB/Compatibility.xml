            <xpath>Defs/ThingDef[defName="HAR_CO_UB_Bullet_c"]</xpath>
            <value>
              <li Class="zades.ayamedukiracece.AbilityExplosionExtension"/>
            </value>
          </li>
          <li Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="HAR_CO_NPC_Race_a"]</xpath>
            <value>
              <li Class="CombatExtended.RacePropertiesExtensionCE">
                <bodyShape>Quadruped</bodyShape>
              </li>
            </value>
          </li>
          <li Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="HAR_CO_NPC_Race_a"]/statBases</xpath>
            <value>
              <Suppressability>0</Suppressability>
              <SmokeSensitivity>0</SmokeSensitivity>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="HAR_CO_NPC_Race_a"]/statBases/ArmorRating_Sharp</xpath>
