<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>[Aya]Chaoura Race</li>
    </mods>
    <match Class="PatchOperationConditional">
      <xpath>Defs/ThingDef[defName="HAR_CO_Weapon_UB"]</xpath>
