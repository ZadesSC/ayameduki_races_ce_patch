        <operations>
          <li Class="PatchOperationRemove">
            <xpath>Defs/ThingDef[defName="HAR_CO_Weapon_UB"]/verbs</xpath>
          </li>
          <li Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="HAR_CO_Weapon_UB"]</xpath>
