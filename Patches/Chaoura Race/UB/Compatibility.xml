            </value>
          </li>
          <li Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="HAR_CO_NPC_Race_a"]/tools</xpath>
            <value>
              <tools Inherit="False">
                <li Class="CombatExtended.ToolCE">
                  <label>left claw</label>
                  <capacities>
                    <li>ScratchToxic</li>
                  </capacities>
                  <power>1</power>
