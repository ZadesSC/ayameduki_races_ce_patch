              <xpath>Defs/BodyDef[defName="HAR_CO_M_Body"]//*[def="Body" or def="Tail" or def="Neck" or def="Head" or def="Leg" or def="Paw" or def="Eye" or def="Ear" or def="AnimalJaw"]/groups[not(li="CoveredByNaturalArmor")]</xpath>
