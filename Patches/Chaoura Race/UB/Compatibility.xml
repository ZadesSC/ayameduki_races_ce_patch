              </tools>
            </value>
          </li>
          <li Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="HAR_CO_Weapon_UB"]/statBases</xpath>
            <value>
              <Bulk>6.65</Bulk>
              <ToughnessRating>20.631</ToughnessRating>
            </value>
          </li>
          <li Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="HAR_CO_Weapon_UB"]</xpath>
            <value>
              <li Class="zades.ayamedukiracece.AreaMeleeExtension">
                <radius>3</radius>
              </li>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <xpath>Defs/ManeuverDef[defName="HAR_CO_UB_Damage_EX"]/verb/verbClass</xpath>
            <value>
              <verbClass>CombatExtended.Verb_MeleeAttackCE</verbClass>
            </value>
          </li>
          <li Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="HAR_CO_Apparel_Tops_z"]/statBases</xpath>
            <value>
              <Bulk>1</Bulk>
              <WornBulk>1</WornBulk>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="HAR_CO_Apparel_Tops_z"]/equippedStatOffsets/MeleeArmorPenetration</xpath>
            <value>
              <MeleePenetrationFactor>1</MeleePenetrationFactor>
            </value>
          </li>
          <li Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="HAR_CO_UB_Bullet_a"]</xpath>
