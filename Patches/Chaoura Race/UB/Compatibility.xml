			</extraMeleeDamages>
                  </surpriseAttack>
                  <armorPenetrationSharp>0.5</armorPenetrationSharp>
                  <armorPenetrationBlunt>2</armorPenetrationBlunt>
                </li>
              </tools>
            </value>
          </li>
          <li Class="PatchOperationConditional">
            <xpath>Defs/BodyDef[defName="HAR_CO_M_Body"]//*[def="Body" or def="Tail" or def="Neck" or def="Head" or def="Leg" or def="Paw" or def="Eye" or def="Ear" or def="AnimalJaw"][not(groups)]</xpath>
            <match Class="PatchOperationAdd">
              <xpath>Defs/BodyDef[defName="HAR_CO_M_Body"]//*[def="Body" or def="Tail" or def="Neck" or def="Head" or def="Leg" or def="Paw" or def="Eye" or def="Ear" or def="AnimalJaw"][not(groups)]</xpath>
