              <tools Inherit="False">
                <li Class="CombatExtended.ToolCE">
                  <label>Ensof’or</label>
                  <capacities>
                    <li>HAR_CO_UB_Damage_EX</li>
                  </capacities>
                  <power>100</power>
                  <cooldownTime>0.2</cooldownTime>
                  <armorPenetrationSharp>96</armorPenetrationSharp>
                  <armorPenetrationBlunt>8</armorPenetrationBlunt>
