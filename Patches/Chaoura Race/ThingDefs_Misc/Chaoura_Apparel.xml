          <operations>
            <li Class="PatchOperationReplace">
              <xpath>Defs/ThingDef[ defName="HAR_CO_Apparel_Tops_a" or defName="HAR_CO_Apparel_Tops_b" or defName="HAR_CO_Apparel_Tops_c" ]/statBases/StuffEffectMultiplierArmor</xpath>
