<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>[Aya]Idearn Race</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/HediffDef[defName="HAR_IA_Skill_Hediff_b"]/stages/li[1]/statOffsets/ArmorRating_Blunt</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/HediffDef[defName="HAR_IA_Skill_Hediff_b"]/stages/li[1]/statOffsets/ArmorRating_Blunt</xpath>
            <value>
              <ArmorRating_Blunt>20</ArmorRating_Blunt>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/HediffDef[defName="HAR_IA_Skill_Hediff_b"]/stages/li[1]/statOffsets/ArmorRating_Sharp</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/HediffDef[defName="HAR_IA_Skill_Hediff_b"]/stages/li[1]/statOffsets/ArmorRating_Sharp</xpath>
            <value>
              <ArmorRating_Sharp>8</ArmorRating_Sharp>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/HediffDef[defName="HAR_IA_Gunshot"]/stages/li[1]/statOffsets/ArmorRating_Sharp</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/HediffDef[defName="HAR_IA_Gunshot"]/stages/li[1]/statOffsets/ArmorRating_Sharp</xpath>
            <value>
              <ArmorRating_Sharp>-8</ArmorRating_Sharp>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/HediffDef[defName="HAR_IA_Gunshot"]/stages/li[1]/statOffsets/ArmorRating_Blunt</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/HediffDef[defName="HAR_IA_Gunshot"]/stages/li[1]/statOffsets/ArmorRating_Blunt</xpath>
            <value>
              <ArmorRating_Blunt>-20</ArmorRating_Blunt>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
