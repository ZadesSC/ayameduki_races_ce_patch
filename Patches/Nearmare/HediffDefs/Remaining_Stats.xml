<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>[Aya]Nearmare Race</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/HediffDef[defName="HAR_NM_Skill_Hediff_e"]/stages/li[1]/statOffsets/ArmorRating_Sharp</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/HediffDef[defName="HAR_NM_Skill_Hediff_e"]/stages/li[1]/statOffsets/ArmorRating_Sharp</xpath>
            <value>
              <ArmorRating_Sharp>-16</ArmorRating_Sharp>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/HediffDef[defName="HAR_NM_Skill_Hediff_e"]/stages/li[1]/statOffsets/ArmorRating_Blunt</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/HediffDef[defName="HAR_NM_Skill_Hediff_e"]/stages/li[1]/statOffsets/ArmorRating_Blunt</xpath>
            <value>
              <ArmorRating_Blunt>-40</ArmorRating_Blunt>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/HediffDef[defName="HAR_NM_Hediff_Potency_a"]/stages/li[minSeverity="0.2"]/statFactors/MeleeArmorPenetration</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/HediffDef[defName="HAR_NM_Hediff_Potency_a"]/stages/li[minSeverity="0.2"]/statFactors/MeleeArmorPenetration</xpath>
            <value>
              <MeleePenetrationFactor>1.5</MeleePenetrationFactor>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/HediffDef[defName="HAR_NM_Hediff_Potency_b"]/stages/li[minSeverity="0.2"]/statFactors/ArmorRating_Sharp</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/HediffDef[defName="HAR_NM_Hediff_Potency_b"]/stages/li[minSeverity="0.2"]/statFactors/ArmorRating_Sharp</xpath>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/HediffDef[defName="HAR_NM_Hediff_Potency_b"]/stages/li[minSeverity="0.2"]/statFactors/ArmorRating_Blunt</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/HediffDef[defName="HAR_NM_Hediff_Potency_b"]/stages/li[minSeverity="0.2"]/statFactors/ArmorRating_Blunt</xpath>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/HediffDef[defName="HAR_NM_Hediff_Potency_b"]/stages/li[minSeverity="0.2"]</xpath>
          <match Class="PatchOperationSequence">
            <operations>
              <li Class="PatchOperationConditional">
                <xpath>Defs/HediffDef[defName="HAR_NM_Hediff_Potency_b"]/stages/li[minSeverity="0.2"]/statOffsets</xpath>
                <nomatch Class="PatchOperationAdd">
                  <xpath>Defs/HediffDef[defName="HAR_NM_Hediff_Potency_b"]/stages/li[minSeverity="0.2"]</xpath>
                  <value>
                    <statOffsets/>
                  </value>
                </nomatch>
              </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/HediffDef[defName="HAR_NM_Hediff_Potency_b"]/stages/li[minSeverity="0.2"]/statOffsets</xpath>
                <value>
                  <ArmorRating_Sharp>4</ArmorRating_Sharp>
                  <ArmorRating_Blunt>10</ArmorRating_Blunt>
                </value>
              </li>
            </operations>
          </match>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
