<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!-- Equipped armor offsets affect the wearer separately from the item's own armor.
       Use fixed CE values based on 1.6/1.7 offsets x16 sharp and x40 blunt.
       Apply those values across supported versions; retain heat and other effects.
       Guard each replacement because older mod versions may lack these items or offsets. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>[Aya]Nearmare Race</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HAR_NM_Weapon_Sword_a"]/equippedStatOffsets/ArmorRating_Sharp</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="HAR_NM_Weapon_Sword_a"]/equippedStatOffsets/ArmorRating_Sharp</xpath>
            <value>
              <ArmorRating_Sharp>4.8</ArmorRating_Sharp>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HAR_NM_Weapon_Sword_a"]/equippedStatOffsets/ArmorRating_Blunt</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="HAR_NM_Weapon_Sword_a"]/equippedStatOffsets/ArmorRating_Blunt</xpath>
            <value>
              <ArmorRating_Blunt>12</ArmorRating_Blunt>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HAR_NM_Os_Pg" or defName="HAR_NM_Wear_r"]/equippedStatOffsets/ArmorRating_Sharp</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="HAR_NM_Os_Pg" or defName="HAR_NM_Wear_r"]/equippedStatOffsets/ArmorRating_Sharp</xpath>
            <value>
              <ArmorRating_Sharp>8</ArmorRating_Sharp>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HAR_NM_Os_Pg" or defName="HAR_NM_Wear_r"]/equippedStatOffsets/ArmorRating_Blunt</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="HAR_NM_Os_Pg" or defName="HAR_NM_Wear_r"]/equippedStatOffsets/ArmorRating_Blunt</xpath>
            <value>
              <ArmorRating_Blunt>20</ArmorRating_Blunt>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HAR_NM_DLArmor"]/equippedStatOffsets/ArmorRating_Sharp</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="HAR_NM_DLArmor"]/equippedStatOffsets/ArmorRating_Sharp</xpath>
            <value>
              <ArmorRating_Sharp>1.6</ArmorRating_Sharp>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HAR_NM_DLArmor"]/equippedStatOffsets/ArmorRating_Blunt</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="HAR_NM_DLArmor"]/equippedStatOffsets/ArmorRating_Blunt</xpath>
            <value>
              <ArmorRating_Blunt>4</ArmorRating_Blunt>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HAR_NM_KArmor"]/equippedStatOffsets/ArmorRating_Sharp</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="HAR_NM_KArmor"]/equippedStatOffsets/ArmorRating_Sharp</xpath>
            <value>
              <ArmorRating_Sharp>-1.6</ArmorRating_Sharp>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HAR_NM_KArmor"]/equippedStatOffsets/ArmorRating_Blunt</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="HAR_NM_KArmor"]/equippedStatOffsets/ArmorRating_Blunt</xpath>
            <value>
              <ArmorRating_Blunt>-4</ArmorRating_Blunt>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HAR_NM_HCArmor"]/equippedStatOffsets/ArmorRating_Sharp</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="HAR_NM_HCArmor"]/equippedStatOffsets/ArmorRating_Sharp</xpath>
            <value>
              <ArmorRating_Sharp>-0.8</ArmorRating_Sharp>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HAR_NM_HCArmor"]/equippedStatOffsets/ArmorRating_Blunt</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="HAR_NM_HCArmor"]/equippedStatOffsets/ArmorRating_Blunt</xpath>
            <value>
              <ArmorRating_Blunt>-2</ArmorRating_Blunt>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
